# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase.
# Si se dejan vacíos, la app arranca en "modo demo" y guarda los datos en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para el script de línea de comandos (npm run panel): tu cuenta de la app.
PANEL_EMAIL=
PANEL_PASSWORD=
