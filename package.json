{
  "name": "panel-de-vida",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "panel": "node --env-file=.env.local scripts/panel.mjs",
    "test:db": "node tests/schema.test.mjs",
    "test:assistant": "npx -y deno run --config supabase/functions/assistant/deno.json --allow-net --allow-env --allow-read tests/assistant.test.ts",
    "test:lib": "npx -y deno run --no-config --sloppy-imports tests/importer.test.ts && npx -y deno run --no-config --sloppy-imports tests/recurring.test.ts && npx -y deno run --no-config --sloppy-imports tests/blocks.test.ts && npx -y deno run --no-config --sloppy-imports tests/errors.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
